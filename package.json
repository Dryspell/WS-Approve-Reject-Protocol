{
  "name": "nashfall",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n db,web -c blue,green --kill-others-on-fail false \"spacetime start || echo [db] SpacetimeDB already running\" \"vinxi dev --port 3001\"",
    "dev:client": "vinxi dev --port 3001",
    "dev:db:local": "spacetime start",
    "publish:local": "cd server && spacetime publish --server local -p . --yes game",
    "publish:cloud": "cd server && spacetime publish -p . socket-signals",
    "build": "vinxi build",
    "start": "vinxi start",
    "typecheck": "tsc --noEmit",
    "typecheck:warn": "tsc --noEmit || echo '[WARN] TypeScript errors detected - review before committing'",
    "test": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:reset-db": "npx tsx scripts/reset-test-db.ts",
    "test:smoke": "playwright test e2e/0-smoke.spec.ts",
    "test:e2e": "pnpm typecheck:warn && pnpm test:reset-db && playwright test",
    "test:e2e:fast": "playwright test",
    "test:e2e:p1": "pnpm typecheck:warn && pnpm test:reset-db && playwright test e2e/priority-1-core-voting.spec.ts",
    "test:e2e:ready": "pnpm typecheck:warn && pnpm test:reset-db && playwright test -g \"Ready|ready\"",
    "test:e2e:flow": "pnpm typecheck:warn && pnpm test:reset-db && playwright test e2e/full-game-flow.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:simulate": "playwright test e2e/full-game-simulation.spec.ts --headed --project=headed-simulation",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings -p server --yes",
    "logs:local": "spacetime logs --server local game",
    "logs:cloud": "spacetime logs socket-signals",
    "sql:local": "spacetime sql --server local game",
    "sql:cloud": "spacetime sql socket-signals",
    "kill-ports": "npx --yes kill-port 3001",
    "bots": "npx tsx scripts/bot-runner.ts"
  },
  "dependencies": {
    "@corvu/resizable": "^0.2.5",
    "@fontsource/inter": "^5.2.5",
    "@kobalte/core": "^0.13.9",
    "@ngneat/falso": "^7.3.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@solid-primitives/storage": "4.2.1",
    "@solid-primitives/timer": "^1.4.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "0.15.1",
    "@solidjs/start": "^1.1.4",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "autoprefixer": "^10.4.21",
    "axios": "^1.9.0",
    "axios-cache-interceptor": "^1.8.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "canvas": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-solid": "^8.6.0",
    "jsonwebtoken": "^9.0.2",
    "munkres-js": "^1.2.2",
    "pixi.js": "^8.16.0",
    "postcss": "^8.5.3",
    "simplex-noise": "^4.0.3",
    "solid-icons": "^1.1.0",
    "solid-js": "^1.9.7",
    "spacetimedb": "2.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.183.1",
    "tuplify": "^0.1.1",
    "vinxi": "^0.5.6"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "0.7.10",
    "@playwright/test": "^1.57.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.23",
    "@types/three": "^0.183.1",
    "@vitest/coverage-v8": "^3.1.4",
    "concurrently": "^9.1.2",
    "daisyui": "^5.0.43",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "vitest": "^3.1.4"
  }
}
